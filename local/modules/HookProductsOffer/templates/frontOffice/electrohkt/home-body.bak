<div class="bg-white">
  <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24 lg:max-w-7xl lg:px-8">
    <h2 class="sr-only">Products</h2>

    <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 xl:gap-x-8">
{loop name="product_promo" type="product" limit="8" promo="yes"}
      <a href="{$URL}" class="group">
        {loop name="product_thumbnail" type="image" product=$ID width="300" height="300" resize_mode="borders" limit="1"}
          <img src="{$IMAGE_URL}" alt="{$TITLE}" class="aspect-square w-full rounded-lg bg-gray-200 object-cover group-hover:opacity-75 xl:aspect-7/8" />
        {/loop}
        {elseloop rel="product_thumbnail"}
          <img src="/assets/img/placeholder.jpg" alt="{$TITLE}" class="aspect-square w-full rounded-lg bg-gray-200 object-cover group-hover:opacity-75 xl:aspect-7/8" />
        {/elseloop}
        <h3 class="mt-4 text-sm text-gray-700">{$TITLE}</h3>
        <div class="mt-1">
          {if $IS_PROMO}
            <p class="text-lg font-medium text-gray-900">{format_money number=$BEST_TAXED_PRICE}</p>
            <p class="text-sm text-gray-500 line-through">{format_money number=$TAXED_PRICE}</p>
          {else}
            <p class="text-lg font-medium text-gray-900">{format_money number=$BEST_TAXED_PRICE}</p>
          {/if}
        </div>
      </a>
{/loop}
    </div>
  </div>
</div>
